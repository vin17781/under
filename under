<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>EMQX MQTT Auto-Publish for App Inventor</title>
  <script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
</head>
<body style="font-family: sans-serif; text-align: center; padding-top: 50px;">
  <h2>MQTT - Pubblicazione automatica</h2>
  <p id="status">Connessione al broker...</p>

  <script>
    const topic = "giufanuni";
    const message = "1";
    const client = mqtt.connect("wss://broker.emqx.io:8084/mqtt");

    client.on("connect", function () {
      client.publish(topic, message);
      const msg = "✅ Pubblicato: '" + message + "' su topic '" + topic + "'";
      document.getElementById("status").innerText = msg;
      if (window.AppInventor) {
        window.AppInventor.setWebViewString(msg);
      }
    });

    client.on("error", function (err) {
      const errorMsg = "❌ Errore: " + err.message;
      document.getElementById("status").innerText = errorMsg;
      if (window.AppInventor) {
        window.AppInventor.setWebViewString(errorMsg);
      }
    });
  </script>
</body>
</html>
